# Keep source files stable across Windows and Unix checkouts.
* text=auto

*.cs    text eol=crlf
*.csproj text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf

*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.exe   binary
